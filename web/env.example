# Clerk Auth
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_placeholder
CLERK_SECRET_KEY=sk_test_placeholder
CLERK_WEBHOOK_SECRET=whsec_placeholder

# Database
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"
DIRECT_URL="postgresql://user:password@host:5432/dbname?schema=public"

# AI LLM Providers (Multi-provider with failover)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
SAMBANOVA_API_KEY=your_sambanova_api_key_here
SAMBANOVA_MODEL=Meta-Llama-3.1-8B-Instruct
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-pro

# AI Constraint Engine (Python)
CONSTRAINT_ENGINE_URL=http://localhost:8001
AI_AGENT_URL=http://127.0.0.1:8001/analyze
AI_SERVICE_URL="http://127.0.0.1:8001"

# Redis (optional, for caching)
REDIS_URL=redis://localhost:6379

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
